# ESP-IDF v6.1, --preview esp32s31: the ESP-Mosaico's 16 MB flash and 16 MB in-package PSRAM.
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MEMTEST=n
# The console on UART0 and on USB Serial/JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
# LVGL 9: RGB565, FreeRTOS, the fonts the demo uses.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_32=y
# Reproducible: no build date or paths, a fixed project version.
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_APP_EXCLUDE_PROJECT_VER_VAR=n
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="mosaico-demo-1"
