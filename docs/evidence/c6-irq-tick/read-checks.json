      "c6-hello",
      "c6-energy-scan",
      "c6-contiki",
      "c6-contiki-net",
      "c6-rpl-net",
      "panel"
    ],
    "exit": 0
  },
  {
    "name": "privacy",
    "command": [
      "node",
      "tools/check-evidence-privacy.mjs"
    ],
    "exit": 0
  },
  {
    "name": "build-bins",
    "command": [
      "nice",
      "-n",
      "10",
      "cargo",
      "+1.99.0",
      "build",
