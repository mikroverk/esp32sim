[
  {
    "name": "clippy-native",
    "command": [
      "nice",
      "-n",
      "10",
      "cargo",
      "+1.99.0",
      "clippy",
      "--workspace",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "clippy-wasm",
    "command": [
      "nice",
      "-n",
      "10",
      "cargo",
      "+1.99.0",
      "clippy",
      "--release",
      "--target",
      "wasm32-unknown-unknown",
      "-p",
      "esp32sim-wasm",
      "--features",
      "jit-tests",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "test-ci",
    "command": [
      "nice",
      "-n",
      "10",
      "cargo",
      "+1.99.0",
      "test",
      "--release",
      "--workspace",
      "--",
      "--include-ignored",
      "--skip",
      "external_"
    ],
    "exit": 0
  },
  {
    "name": "test-plain",
    "command": [
      "nice",
      "-n",
      "10",
      "cargo",
      "+1.99.0",
      "test",
      "--release",
      "--workspace"
    ],
    "exit": 0
  },
  {
    "name": "wasm-build",
    "command": [
      "nice",
      "-n",
      "10",
      "bash",
      "tools/wasm-build.sh"
    ],
    "exit": 0
  },
  {
    "name": "wasm-tests",
    "command": [
      "nice",
      "-n",
      "10",
      "node",
      "tools/wasm-test.mjs",
