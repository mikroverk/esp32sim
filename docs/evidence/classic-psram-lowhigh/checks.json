{
  "a2-replay": {
    "command": [
      "cargo",
      "+1.99.0",
      "test",
      "--release",
      "-p",
      "esp32sim",
      "--test",
      "classic_psram_lowhigh",
      "--",
      "--ignored",
      "--nocapture"
    ],
    "exit": 0
  },
  "clippy-native": {
    "command": [
      "cargo",
      "+1.99.0",
      "clippy",
      "--workspace",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  "clippy-wasm": {
    "command": [
      "cargo",
      "+1.99.0",
      "clippy",
      "--release",
      "--target",
      "wasm32-unknown-unknown",
      "-p",
      "esp32sim-wasm",
      "--features",
      "jit-tests",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  "test-rom": {
    "command": [
      "cargo",
      "+1.99.0",
      "test",
      "--release",
      "--workspace",
      "--",
      "--include-ignored",
      "--skip",
      "external_"
    ],
    "exit": 0
  },
  "test-plain": {
    "command": [
      "cargo",
      "+1.99.0",
      "test",
      "--release",
      "--workspace"
    ],
    "exit": 0
  },
  "wasm-build": {
    "command": [
      "bash",
      "tools/wasm-build.sh"
    ],
    "exit": 0
  },
  "wasm-demos": {
    "command": [
      "node",
      "tools/wasm-test.mjs",
      "hello",
      "c3-hello",
      "c6-hello",
      "c6-energy-scan",
      "c6-contiki",
      "c6-contiki-net",
      "c6-rpl-net",
      "panel"
    ],
    "exit": 0
  },
  "privacy": {
    "command": [
      "node",
      "tools/check-evidence-privacy.mjs"
    ],
    "exit": 0
  },
  "whitespace": {
    "command": [
      "git",
      "diff",
      "--check"
    ],
    "exit": 0
  }
}
